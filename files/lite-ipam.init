#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

SERVICE_NAME="lite-ipam"
PROG="/usr/libexec/lite-ipam/lite-ipam.sh"

start_service() {
	[ -x "$PROG" ] || return 1
	local enabled data_root
	enabled="$(uci -q get lite-ipam.@core[0].enabled)"
	data_root="$(uci -q get lite-ipam.@core[0].data_root)"
	[ "$enabled" = "1" ] || [ "$enabled" = "true" ] || return 0
	[ -n "$data_root" ] || return 0
	"$PROG" init-service || return 1
	"$PROG" ensure-cron || return 1
	procd_open_instance
	procd_set_param command "$PROG" worker
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	start_service
}

service_triggers() {
	procd_add_reload_trigger "dhcp" "lite-ipam"
}
