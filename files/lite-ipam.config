config core 'core'
	option enabled '1'
	option node_name ''
	option data_root ''
	option auto_init '1'
	option auto_create_subdirs '1'
	option backup_retention_days '30'
	option apply_mode 'immediate'

config api 'api'
	option enabled '0'
	option read_token ''
	option write_token ''
	option max_page_size '500'
	option default_page_size '100'
	option require_token '1'

config sync 'sync'
	option enabled '1'
	option allow_read_api '1'
	option export_full_enabled '1'
	option export_dnsmasq_enabled '1'
	option subnet_interfaces ''

config health 'health'
	option strict_storage_check '1'
	option fail_when_storage_unavailable '1'

config backup 'backup'
	option enabled '1'
	option cron_enabled '1'
	option cron_schedule '0 3 * * *'
	option mail_enabled '0'
	option mail_from ''
	option mail_to ''
	option smtp_host ''
	option smtp_port '587'
	option smtp_user ''
	option smtp_password ''
	option smtp_tls '1'

config maintenance 'maintenance'
	option enabled '1'
	option lease_retention_days '90'
	option event_retention_days '180'
	option vacuum_after_cleanup '1'